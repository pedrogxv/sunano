NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Também usada como segredo HMAC do cookie assinado do "Logar como" do admin
# (lib/server/impersonation.ts) — sem ela o recurso fica indisponível (falha fechada).
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Código de verificação de propriedade do Google Search Console (meta tag
# "google-site-verification"). Gerado ao cadastrar sunano.com.br no Search
# Console — sem isso, a meta tag simplesmente não é enviada.
GOOGLE_SITE_VERIFICATION=


MAINTENANCE_MODE=false
# Variante client-side (NEXT_PUBLIC_*) usada como fallback em proxy.ts — mantenha igual a MAINTENANCE_MODE.
NEXT_PUBLIC_MAINTENANCE_MODE=false

# Bloqueia SOMENTE a Loja pública (não afeta /admin, login/cadastro, Mercado
# nem o resto do site). Com "true": /loja e /loja/[slug] mostram uma tela de
# "em breve" (sem listar produtos) e POST /api/store/checkout passa a
# recusar qualquer pedido novo com 503 — nenhuma compra é possível enquanto
# ativo. Ver proxy.ts e app/api/store/checkout/route.ts.
STORE_MAINTENANCE_MODE=false
# Variante client-side (NEXT_PUBLIC_*) usada como fallback em proxy.ts — mantenha igual a STORE_MAINTENANCE_MODE.
NEXT_PUBLIC_STORE_MAINTENANCE_MODE=false

# Horário-alvo do lançamento mostrado como contagem regressiva na tela de
# "em breve" da Loja (ISO 8601, em UTC). Opcional — sem essa env (ou com valor
# inválido) a tela de "em breve" simplesmente não mostra countdown nenhum.
# Ajustar aqui NÃO desativa a manutenção sozinho: quando o timer chega a zero,
# a página só dá reload — a Loja só abre de fato quando
# STORE_MAINTENANCE_MODE=false. Ver lib/store-maintenance.ts.
STORE_LAUNCH_AT=
# Variante client-side (NEXT_PUBLIC_*) usada como fallback — mantenha igual a STORE_LAUNCH_AT.
NEXT_PUBLIC_STORE_LAUNCH_AT=

# Liga/desliga a assinatura VIP paga por cartão (Asaas). Com "false" (ou
# ausente), o botão "Assinar" some do modal de VIP e POST /api/vip/subscribe
# recusa com 503 — nenhuma cobrança é possível enquanto desativado. NÃO afeta
# ativar VIP resgatando Aura, que continua disponível. Ver lib/vip-signup.ts.
VIP_SUBSCRIPTION_ENABLED=false
# Variante client-side (NEXT_PUBLIC_*) usada pelo modal — mantenha igual a VIP_SUBSCRIPTION_ENABLED.
NEXT_PUBLIC_VIP_SUBSCRIPTION_ENABLED=false

# Protege /api/cron/lgpd-cleanup: exigido como "Authorization: Bearer $CRON_SECRET".
# Sem essa variável configurada, a rota rejeita todas as chamadas (falha fechada).
CRON_SECRET=

# Salt usado para hashear IP+user-agent em rate_limit_events (lib/server/rate-limit.ts).
# Sem essa variável, cai num fallback público hardcoded no código-fonte — configure
# um valor aleatório e secreto em produção.
RATE_LIMIT_SALT=

# Cloudflare Turnstile — captcha do login e cadastro (app/login/actions.ts,
# app/register/actions.ts, components/auth/TurnstileWidget.tsx). Gere as
# chaves em https://dash.cloudflare.com/?to=/:account/turnstile (widget tipo
# "Managed", que só interrompe o usuário quando o Cloudflare suspeita de bot).
# Sem TURNSTILE_SECRET_KEY configurada, a verificação server-side "falha
# aberto" (login/cadastro seguem funcionando sem captcha) — útil em dev local,
# mas configure ambas em produção para a proteção valer de fato. Sem a chave
# pública, o widget simplesmente não aparece no formulário.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Supabase Auth email delivery
# Configure these values in your deployment environment and Supabase project SMTP settings.
SUPABASE_SMTP_HOST=
SUPABASE_SMTP_PORT=587
SUPABASE_SMTP_USER=
SUPABASE_SMTP_PASSWORD=
SUPABASE_SMTP_FROM="Sunano <no-reply@sunano.com>"


# YouTube Data API v3
# You can use any Google Cloud project/API key; it does not need to belong to the channel owner.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_HANDLE=@sunano_
# Optional: set directly to skip handle lookup
YOUTUBE_CHANNEL_ID=

# "Confirmar inscrição" (app/auth/youtube/callback) reaproveita o provider
# Google já configurado no Supabase Dashboard (Authentication > Providers >
# Google) — nenhuma env nova aqui. Só é preciso garantir que o OAuth consent
# screen desse projeto no Google Cloud Console declara o escopo
# "https://www.googleapis.com/auth/youtube.readonly" (Scopes); sem isso o
# Google pode não devolver o provider_token com esse escopo.

# Liga/desliga a conquista "Inscrito" (inscrição no canal do YouTube via
# OAuth, credita 50 de Aura). Com "false" (ou ausente), o card some da
# Central de Aura, o botão some do popover de missões da TopBar, e tanto
# /api/youtube/subscription-status quanto o callback OAuth ficam inertes.
# Ver lib/youtube-subscription.ts.
YOUTUBE_SUBSCRIPTION_ENABLED=false
# Variante client-side (NEXT_PUBLIC_*) usada pelo popover da TopBar — mantenha igual a YOUTUBE_SUBSCRIPTION_ENABLED.
NEXT_PUBLIC_YOUTUBE_SUBSCRIPTION_ENABLED=false

# Asaas — gateway de pagamento (Loja & Bazar), PIX e cartão de crédito.
# Docs: https://docs.asaas.com
# OBRIGATÓRIA e explícita: só aceita "production" ou "sandbox". Valor ausente
# ou com typo agora é ERRO, não mais um default silencioso para sandbox —
# cair em sandbox num deploy de produção faria pagamento de teste liberar
# pedido real. "sandbox" também é recusado quando VERCEL_ENV=production.
#
# Também define `store_orders.is_sandbox` em cada pedido criado: com "sandbox"
# o pedido nasce marcado como teste e some das telas do cliente, da Receita do
# dashboard e da fila do admin (que abre em "Produção" e tem seletor de
# ambiente). Não gera comissão de afiliado nem selo de "compra verificada".
ASAAS_ENV=sandbox
# Painel sandbox: https://sandbox.asaas.com/config/tokensAndKeys | produção: https://www.asaas.com/config/tokensAndKeys
ASAAS_API_KEY=
# Configurado ao criar o webhook no painel Asaas (endpoint: /api/webhooks/asaas,
# eventos PAYMENT_*). 32-255 caracteres, sem espaços — não é a API key.
ASAAS_WEBHOOK_TOKEN=
# Token do SEGUNDO webhook, cadastrado separadamente no painel Asaas com
# endpoint /api/webhooks/asaas-checkout e os eventos CHECKOUT_PAID,
# CHECKOUT_EXPIRED, CHECKOUT_CANCELED marcados (cartão de crédito). Cada
# webhook cadastrado gera seu próprio token — não reaproveitar o token acima.
ASAAS_WEBHOOK_CHECKOUT_TOKEN=
# Token do TERCEIRO webhook, cadastrado separadamente no painel Asaas com
# endpoint /api/webhooks/asaas-subscription e os eventos CHECKOUT_PAID,
# PAYMENT_CONFIRMED, PAYMENT_RECEIVED, PAYMENT_OVERDUE, SUBSCRIPTION_DELETED
# marcados (assinatura recorrente do VIP). Não reaproveitar os tokens acima.
ASAAS_WEBHOOK_SUBSCRIPTION_TOKEN=

# Stripe (legado — código removido, variáveis mantidas apenas para referência histórica)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Telegram Offers (lidas do preview público do canal, sem Bot API)
# Username do canal público (ex: @seucanal) — opcional se TELEGRAM_OFFERS_PUBLIC_URL já tiver o username
TELEGRAM_OFFERS_CHAT_ID=
# URL do canal público, usada para montar t.me/s/<canal> e como link de fallback (ex: https://t.me/seucanal)
TELEGRAM_OFFERS_PUBLIC_URL=

# Seletor de GIF em comentários e posts (KLIPY — substituto da Tenor API, que o
# Google desligou em 30/06/2026). Chave em partner.klipy.com > API Keys.
# É NEXT_PUBLIC de propósito: os requisitos de integração do KLIPY exigem que a
# chamada parta do browser (sem proxy no servidor), e a chave é read-only, vai
# no path da URL e tem rate limit por chave. Chave em modo Testing = 100
# req/hora; após "Request Production Access" no painel = ilimitado.
# Sem a chave, o botão "GIF" aparece mas a busca fica indisponível.
NEXT_PUBLIC_KLIPY_API_KEY=
# ─────────────────────────────────────────────────────────────────────────────
# Discord — notificação de pedidos da Loja
# ─────────────────────────────────────────────────────────────────────────────
# Cada pedido ganha UMA THREAD no canal abaixo, com um painel fixado (reescrito
# a cada evento) e o histórico de status empilhado dentro dela. Threads em vez
# de um canal por pedido: o Discord limita 500 canais por servidor, threads não
# têm teto e arquivam sozinhas. Ver lib/server/integrations/discord.ts.
#
# DESLIGADO ENQUANTO AS DUAS PRIMEIRAS VARIÁVEIS ESTIVEREM VAZIAS — a Loja
# funciona exatamente igual sem isso configurado.
#
# NÃO CONFUNDIR COM O "LOGIN COM DISCORD" (components/auth/DiscordAuthButton.tsx):
# aquilo é OAuth — Client ID/Secret guardados no dashboard do Supabase, que
# autenticam O USUÁRIO que clicou no botão. Aqui é um BOT TOKEN, que autentica
# a APLICAÇÃO sozinha. As credenciais não se reaproveitam, e não é escolha de
# estilo: os eventos de pedido nascem em webhook da Asaas e em cron, onde não
# há usuário nenhum na tela para consentir um fluxo OAuth — e um token OAuth é
# emitido em nome de uma pessoa e expira. O escopo OAuth que mais se aproxima
# (`webhook.incoming`) posta num canal fixo e NÃO cria threads, que é
# justamente o desenho usado aqui.
#
# O que dá para reaproveitar é a APPLICATION: use a mesma que já serve o login
# com Discord, e o bot nasce sob a mesma identidade/ícone "Sunano".
#
# COMO CONFIGURAR (5 minutos):
#  1. https://discord.com/developers/applications > abra a Application que já
#     é usada no login com Discord (ou crie uma nova, se preferir separar) >
#     aba Bot > Add Bot, se ainda não existir > Reset Token > copie em
#     DISCORD_BOT_TOKEN. NUNCA commitar esse valor.
#  2. Na mesma tela, aba OAuth2 > URL Generator: marque `bot`, e nas permissões
#     marque: View Channels, Send Messages, Send Messages in Threads,
#     Create Public Threads, Embed Links, Manage Messages (para fixar o painel).
#     Abra a URL gerada e adicione o bot ao seu servidor.
#  3. No Discord, Configurações do Usuário > Avançado > ligue "Modo de
#     Desenvolvedor". Clique com o botão direito no canal de pedidos >
#     "Copiar ID do canal" > cole em DISCORD_ORDERS_CHANNEL_ID.
#  4. (opcional) Botão direito no cargo da equipe > "Copiar ID" >
#     DISCORD_ADMIN_ROLE_ID. Esse cargo é mencionado SÓ nos eventos que pedem
#     ação humana (pago, aguardando envio, estorno, chargeback, pago sem
#     estoque) — nunca em "entregue"/"expirado", pra menção não virar ruído.
#  5. Aplique a migration 20261014000000_discord_order_threads.sql.
#  6. Teste: `npx tsx scripts/test-discord-orders.ts <id-do-pedido>`
#
# Token do bot (Discord Developer Portal > Bot > Reset Token). SEGREDO.
DISCORD_BOT_TOKEN=
# ID do canal onde as threads de pedido são criadas (botão direito > Copiar ID).
DISCORD_ORDERS_CHANNEL_ID=
# ID do cargo mencionado quando o pedido exige ação do admin. Opcional —
# sem ele os cards continuam saindo, só não pingam ninguém.
DISCORD_ADMIN_ROLE_ID=
# "true" publica também pedidos de sandbox (ASAAS_ENV=sandbox). Padrão: não —
# pagamento de teste não deve poluir o canal usado para operar de verdade.
DISCORD_ORDERS_INCLUDE_SANDBOX=false

# ─────────────────────────────────────────────────────────────────────────────
# Discord — conquista "No Discord" (Central de Aura)
# ─────────────────────────────────────────────────────────────────────────────
# Um clique que faz DUAS coisas: vincula a conta do Discord ao perfil (a mesma
# vinculação de /conta > Contas vinculadas) e confirma que a pessoa é MEMBRO do
# servidor oficial — creditando 50 de Aura, uma vez só por conta.
# Ver app/auth/discord/callback/route.ts e lib/discord-membership.ts.
#
# NÃO PRECISA DE NENHUMA PERMISSÃO NOVA DO BOT nem do privileged intent
# GUILD_MEMBERS. A verificação é feita com o access token OAuth DO PRÓPRIO
# USUÁRIO (`GET /users/@me/guilds`), emitido no consentimento — o bot de
# pedidos acima segue com exatamente as mesmas permissões de antes.
#
# COMO CONFIGURAR:
#  1. Reaproveita o provider Discord JÁ configurado no dashboard do Supabase
#     (Authentication > Providers > Discord), o mesmo do "Login com Discord" —
#     nenhum Client ID/Secret novo. O escopo extra `guilds` é pedido em tempo
#     de requisição pelo botão (components/auth/DiscordMembershipButton.tsx);
#     o Discord não exige declarar escopo antecipadamente no portal, ao
#     contrário do consent screen do Google.
#  2. Modo de Desenvolvedor ligado no Discord > botão direito no ícone do
#     SERVIDOR > "Copiar ID do servidor" > cole em DISCORD_GUILD_ID.
#  3. Crie um convite que não expira do servidor e cole em
#     NEXT_PUBLIC_DISCORD_INVITE_URL (opcional, mas sem ele quem ainda não é
#     membro não tem para onde ir a partir do card).
#  4. Aplique a migration 20261015000000_discord_membership_achievement.sql.
#
# ID do servidor cuja participação vale a conquista. Sem ele o callback recusa.
DISCORD_GUILD_ID=
# Liga/desliga a conquista "No Discord". Com "false" (ou ausente), o card some
# da Central de Aura e o callback OAuth fica inerte.
DISCORD_MEMBERSHIP_ENABLED=false
# Variante client-side (NEXT_PUBLIC_*) — mantenha igual a DISCORD_MEMBERSHIP_ENABLED.
NEXT_PUBLIC_DISCORD_MEMBERSHIP_ENABLED=false
# Convite público do servidor, mostrado no card a quem ainda não é membro. Opcional.
NEXT_PUBLIC_DISCORD_INVITE_URL=
